TZ=Asia/Shanghai

# App HTTP port on host
APP_PORT=3000

# Device TCP report port on host
TCP_PORT_PUBLIC=3888

# Optional Nginx HTTP port when running with --profile proxy
NGINX_HTTP_PORT=80

# Persistent inbound queue settings
MESSAGE_QUEUE_MAX_SIZE=10000
MESSAGE_QUEUE_BATCH_SIZE=50
MESSAGE_QUEUE_POLL_INTERVAL=1000
MESSAGE_QUEUE_MAX_ATTEMPTS=8
TCP_MAX_BUFFER_BYTES=1048576

# Operational log and dead-letter retention period
LOG_RETENTION_DAYS=30
DEAD_LETTER_RETENTION_DAYS=30

# Watchdog inspection and recovery. Automatic recovery is disabled for each
# device until enabled in its detail page.
WATCHDOG_INTERVAL_MS=30000
WATCHDOG_VERIFY_GRACE_SECONDS=120
WATCHDOG_RESTART_GRACE_SECONDS=180
WATCHDOG_DEVICE_RESTART_COOLDOWN_SECONDS=900
WATCHDOG_SIM_RECOVERY_COOLDOWN_SECONDS=900
WATCHDOG_MAX_RECOVERIES_PER_DAY=2
